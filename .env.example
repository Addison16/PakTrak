# From a Git checkout, run sh scripts/setup.sh to generate this file instead.
# Without Git, copy this file to .env next to compose.yaml, chmod 600 it, and
# fill every empty secret with its own random value (openssl rand -hex 32).
# Use one stable origin. Choose HTTPS for phone deployment behind a trusted proxy.
APP_URL=http://localhost:8095
HTTP_BIND=127.0.0.1
HTTP_PORT=8095
ALLOW_INSECURE_HTTP=true
MAX_UPLOAD_BYTES=104857600
# A release tag without its leading v; scripts/update.sh sets this for you.
PAKTRAK_VERSION=latest
POSTGRES_PASSWORD=
SCANNER_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
SESSION_SECRET=
OIDC_CLIENT_SECRET=
PASSWORD_RESET_CLIENT_SECRET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
KEYCLOAK_ADMIN_PASSWORD=
