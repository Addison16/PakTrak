<#macro content>
  <fieldset class="appearance-picker">
    <legend>Appearance</legend>
    <div class="appearance-options">
      <button type="button" class="appearance-option" data-appearance-mode="auto" aria-pressed="true">Auto</button>
      <button type="button" class="appearance-option" data-appearance-mode="light" aria-pressed="false">Light</button>
      <button type="button" class="appearance-option" data-appearance-mode="dark" aria-pressed="false">Dark</button>
    </div>
    <p class="appearance-note" data-appearance-status>Follows this device</p>
  </fieldset>
  <p class="paktrak-footer"><strong>PakTrak</strong> &middot; Every card. In reach.</p>
</#macro>
